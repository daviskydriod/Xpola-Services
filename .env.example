# Frontend environment variables
# Copy this file to .env.local for local development or configure the same
# values in the frontend hosting provider's environment settings.

# URL of the PHP API. Do not add a trailing slash.
VITE_API_URL=http://localhost:8080/api

# Browser-safe payment public keys only. Never put secret keys in this file.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_paystack_public_key
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-replace_with_flutterwave_public_key
